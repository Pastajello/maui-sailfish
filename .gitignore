# Build outputs
bin/
obj/
TestResults/
*.nupkg
*.snupkg

# Native shim build output (tools/sf native-build; the csproj packs it only when present)
/artifacts/

# Device tooling state: sysroot, RPM cache, pinned host keys
/tools/.sysroot/
/tools/.cache/
/tools/.known_hosts
__pycache__/
*.pyc

# Sailfish device credentials (tools/lib/sf-lib.sh reads connect.info from the repo root or a project dir)
connect.info

# IDE / user-specific files
.vs/
/.idea/
/.vscode/
*.user
*.suo

# Screen recordings: the GIFs in docs/media are tracked, their MP4 sources are not (each re-recording would add
# megabytes to the history for good; owner decision 2026-10-04)
docs/media/**/*.mp4

# OS-generated files
.DS_Store
