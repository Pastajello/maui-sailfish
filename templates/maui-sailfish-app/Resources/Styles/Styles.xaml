    <!-- The colours below apply on Android, iOS, Mac Catalyst and Windows. On Sailfish OS no OnPlatform branch
         matches, so the colour stays unset and the phone's ambience (Silica theme) colours the app, as native
         Sailfish apps look. Add "SailfishOS" to an On's Platform list to use a colour there too. -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color">
            <OnPlatform x:TypeArguments="Color">
                <On Platform="Android, iOS, MacCatalyst, WinUI" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </OnPlatform>
        </Setter>
    </Style>

    <Style TargetType="IndicatorView">
