                <On Platform="Android, iOS, MacCatalyst, WinUI" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
            </OnPlatform>
        </Setter>
        <Setter Property="SelectedIndicatorColor">
            <OnPlatform x:TypeArguments="Color">
                <On Platform="Android, iOS, MacCatalyst, WinUI" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}" />
