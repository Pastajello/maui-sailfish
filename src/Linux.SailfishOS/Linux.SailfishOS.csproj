<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Microsoft.Maui.SailfishOS</RootNamespace>
    <AssemblyName>Microsoft.Maui.SailfishOS</AssemblyName>
    <PackageId>Microsoft.Maui.Platforms.SailfishOS</PackageId>
    <Version>$(PlatformMauiSailfishVersion)</Version>
    <Description>A .NET MAUI backend for Sailfish OS: MAUI apps render as native Qt Quick / Sailfish Silica UI on the device compositor and ship as harbour-style RPMs (linux-arm64, SFOS 5.2+).</Description>
    <PackageTags>maui;sailfish;sailfishos;linux;rpm;harbour;dotnet;cross-platform</PackageTags>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trimmed with the app under TrimMode=partial, as MAUI's own assemblies are (tracker S53); the trim analyzer
         runs on every build, and reflection is rooted where it is used (DynamicDependency). -->
    <IsTrimmable>true</IsTrimmable>
    <!-- Symbols beside the package (snupkg) and SourceLink to the repository (tracker S06). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- The diagnostics assembly drives renderer internals. -->
    <InternalsVisibleTo Include="Microsoft.Maui.SailfishOS.Diagnostics" />
    <!-- Host-side handler parity tests. -->
    <InternalsVisibleTo Include="Linux.SailfishOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- The Essentials service interfaces live here. -->
    <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- Per-file PackagePath: a directory-style one keeps the project-relative path and breaks the auto-import layout. -->
    <!-- The MSBuild tasks of the targets, built first and packed beside them (buildTransitive/net11.0/tasks). -->
    <ProjectReference Include="../Linux.SailfishOS.Build.Tasks/Linux.SailfishOS.Build.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../artifacts/build-tasks/Microsoft.Maui.SailfishOS.Build.Tasks.dll" Pack="true" Visible="false"
          PackagePath="buildTransitive/net11.0/tasks/Microsoft.Maui.SailfishOS.Build.Tasks.dll" />
    <None Include="buildTransitive/**" Pack="true"
          PackagePath="buildTransitive/net11.0/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The QML runtime payload: Content for in-repo outputs, packed once under qml/ (per file, as above) for package consumers. -->
    <Content Include="Platform/QtHost/qml/**/*.qml;Platform/QtHost/qml/**/*.json;Platform/QtHost/qml/**/*.js"
             Link="qml/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
             Pack="true" PackagePath="qml/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- scaffold/ ships to consumers as source; compiling it here would add a second Main. -->
  <ItemGroup>
    <Compile Remove="scaffold/**" />
    <None Include="scaffold/**" Pack="true" PackagePath="buildTransitive/scaffold/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The device tools: the sailfish tool (src/Linux.SailfishOS.Tools, C# over the system ssh/scp, so Windows too;
       tracker S56), built first and packed beside the targets, which run it with dotnet (setup, deploy, dotnet run).
       The bash scripts in tools/ are the repo's own (matrix, shots, native builds) and stay out of the package. -->
  <ItemGroup>
    <ProjectReference Include="../Linux.SailfishOS.Tools/Linux.SailfishOS.Tools.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../artifacts/sailfish-tool/sailfish.dll;../../artifacts/sailfish-tool/sailfish.runtimeconfig.json;../../artifacts/sailfish-tool/sailfish.deps.json"
          Pack="true" Visible="false" PackagePath="buildTransitive/net11.0/tools/sailfish/" />
  </ItemGroup>

  <!-- The native shim as a NuGet native asset; pack fails without it, since the app would die on start. -->
  <ItemGroup Condition="Exists('../../artifacts/native/aarch64/libsailfishhost.so')">
    <None Include="../../artifacts/native/aarch64/libsailfishhost.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/libsailfishhost.so" />
    <!-- Harbour launcher (SailfishHarbour=true). A folder PackagePath: an extension-less file name is read as a folder
         (the launcher landed at native/sailfish-launcher/sailfish-launcher). -->
    <None Include="../../artifacts/native/aarch64/sailfish-launcher"
          Condition="Exists('../../artifacts/native/aarch64/sailfish-launcher')"
          Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <!-- Sailfish Secrets bridge (dlopen'ed, optional) -->
    <None Include="../../artifacts/native/aarch64/libsailfishsecretsbridge.so"
          Condition="Exists('../../artifacts/native/aarch64/libsailfishsecretsbridge.so')"
          Pack="true" PackagePath="runtimes/linux-arm64/native/libsailfishsecretsbridge.so" />
  </ItemGroup>
  <!-- Optional 32-bit ARM assets (SF_ARCH=armv7hl tools/sf native-build) for -r linux-arm. -->
  <ItemGroup Condition="Exists('../../artifacts/native/armv7hl/libsailfishhost.so')">
    <None Include="../../artifacts/native/armv7hl/libsailfishhost.so"
          Pack="true" PackagePath="runtimes/linux-arm/native/libsailfishhost.so" />
    <None Include="../../artifacts/native/armv7hl/sailfish-launcher"
          Condition="Exists('../../artifacts/native/armv7hl/sailfish-launcher')"
          Pack="true" PackagePath="runtimes/linux-arm/native/" />
    <None Include="../../artifacts/native/armv7hl/libsailfishsecretsbridge.so"
          Condition="Exists('../../artifacts/native/armv7hl/libsailfishsecretsbridge.so')"
          Pack="true" PackagePath="runtimes/linux-arm/native/libsailfishsecretsbridge.so" />
  </ItemGroup>

  <Target Name="_SailfishShimRequiredForPack" BeforeTargets="Pack"
          Condition="'$(SailfishAllowMissingShim)' != 'true' And !Exists('../../artifacts/native/aarch64/libsailfishhost.so')">
    <Error Text="libsailfishhost.so is missing - run tools/sf native-build before packing (override with -p:SailfishAllowMissingShim=true)." />
  </Target>

</Project>
