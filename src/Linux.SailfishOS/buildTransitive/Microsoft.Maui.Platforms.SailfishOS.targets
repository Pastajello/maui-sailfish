<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
  Sailfish OS harbour-style RPM packaging for .NET MAUI apps.
      dotnet publish -f net11.0-sailfish                                   (RID, self-contained and RPM are leg defaults)
      dotnet publish -r linux-arm64 -p:SelfContained=true -p:CreateSailfishRpm=true   (plain net11.0 leg)
  Opt out with -p:CreateSailfishRpm=false. Uses host rpmbuild when present, else tools/py/sf-rpmbuild.py.
  -->

  <!-- ================= QML payload for PackageReference consumers ================= -->
  <!-- Package consumers need the package's qml/ re-added as Content; in-repo imports get it via ProjectReference. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../qml/adapters.json') And '$(SailfishIncludeQml)' != 'false'">
    <Content Include="$(MSBuildThisFileDirectory)../../qml/**/*"
             Link="qml/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <!-- ================= Native host shim presence check ================= -->
  <!-- Without libsailfishhost.so the app dies on start, so fail the publish (the native asset lands in PublishDir, not OutDir).
       The gate lives in the Error condition because a Target Condition misbehaved across import contexts. -->
  <Target Name="_SailfishNativeHostCheck" AfterTargets="Publish">
    <Error Condition="'$(SailfishSkipNativeCheck)' != 'true' And '$(RuntimeIdentifier)' != '' And $([System.String]::Copy('$(RuntimeIdentifier)').Contains('linux')) And !Exists('$(OutDir)libsailfishhost.so') And !Exists('$(PublishDir)libsailfishhost.so')"
           Text="libsailfishhost.so is missing from the publish output ($(PublishDir)). Build it with tools/sf native-build, or reference a Microsoft.Maui.Platforms.SailfishOS package carrying runtimes/$(RuntimeIdentifier)/native/. Override with -p:SailfishSkipNativeCheck=true." />
  </Target>

  <!-- ================= net11.0-sailfish TFM recognition ================= -->
  <!-- Setting TargetPlatformSupported here avoids NETSDK1139 and gives the leg the defaults an in-box platform would. -->
  <PropertyGroup>
    <!-- TargetPlatformIdentifier is only set later in SDK targets, so compute the leg platform here, before its consumers. -->
    <_SailfishLegPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_SailfishLegPlatform>
  </PropertyGroup>

  <!-- Packaging identity and store profile, for the sailfish leg and plain net11.0 apps alike. -->
  <PropertyGroup>
    <SailfishOrientation Condition="'$(SailfishOrientation)' == ''">Any</SailfishOrientation>
    <SailfishCover Condition="'$(SailfishCover)' == ''">false</SailfishCover>
    <SailfishOrganizationName Condition="'$(SailfishOrganizationName)' == ''">org.maui</SailfishOrganizationName>
    <!-- Harbour profile: native launcher as the only ELF in /usr/bin, payload in /usr/share/PKG/lib, sandboxing required. -->
    <SailfishHarbour Condition="'$(SailfishHarbour)' == ''">false</SailfishHarbour>
    <!-- Harbour recommends all four launcher icon sizes. -->
    <SailfishIconSizes Condition="'$(SailfishIconSizes)' == ''">86;108;128;172</SailfishIconSizes>
    <!-- Sailjail sandbox in every configuration, so Debug sees the permissions and data dirs Release (and Harbour) get;
         SailfishSandboxing=false opts out with Sandboxing=Disabled. Internet is always granted, since the sandbox has no
         network otherwise and every other MAUI head has it without asking. -->
    <SailfishSandboxing Condition="'$(SailfishSandboxing)' == ''">true</SailfishSandboxing>
    <_SailfishSandboxed>false</_SailfishSandboxed>
    <_SailfishSandboxed Condition="'$(SailfishSandboxing)' == 'true'">true</_SailfishSandboxed>
    <!-- A separate property because a global -p:SailfishPermissions cannot be overridden. SailfishSecureStorage=Secrets adds Secrets. -->
    <_SailfishPermissions>Internet</_SailfishPermissions>
    <_SailfishPermissions Condition="'$(SailfishPermissions)' != '' And $([System.String]::Copy(';$(SailfishPermissions);').Contains(';Internet;'))">$(SailfishPermissions)</_SailfishPermissions>
    <_SailfishPermissions Condition="'$(SailfishPermissions)' != '' And !$([System.String]::Copy(';$(SailfishPermissions);').Contains(';Internet;'))">Internet;$(SailfishPermissions)</_SailfishPermissions>
    <_SailfishPermissions Condition="'$(SailfishSecureStorage)' == 'Secrets' And !$([System.String]::Copy(';$(_SailfishPermissions);').Contains(';Secrets;'))">$(_SailfishPermissions);Secrets</_SailfishPermissions>
    <_SailfishPermissions Condition="'$(_SailfishSandboxed)' != 'true'"></_SailfishPermissions>
  </PropertyGroup>

  <PropertyGroup>
    <!-- An app head, as opposed to a class library with the TFM (OutputType defaults to Library in the SDK props). Only
         heads get the device RID, self-contained payload, RPM and generated Main. -->
    <_SailfishIsApp>false</_SailfishIsApp>
    <_SailfishIsApp Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">true</_SailfishIsApp>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <!-- SAILFISH1_0 and SAILFISH1_0_OR_GREATER come from the SDK once _SailfishRestorePlatformIdentifier puts the
         platform back; SAILFISH is listed here too so evaluation-time consumers (IDE, analyzers) see it. -->
    <DefineConstants>$(DefineConstants);SAILFISH</DefineConstants>
    <EnableDefaultMauiItems Condition="'$(EnableDefaultMauiItems)' == ''">true</EnableDefaultMauiItems>
    <EnableDefaultXamlItems Condition="'$(EnableDefaultXamlItems)' == ''">true</EnableDefaultXamlItems>
    <MauiXamlInflator Condition="'$(MauiXamlInflator)' == ''">SourceGen</MauiXamlInflator>
  </PropertyGroup>

  <!-- CA1416 treats sailfish-only APIs as platform specific, as on the in-box platforms. -->
  <ItemGroup Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <SupportedPlatform Include="sailfish" />
  </ItemGroup>

  <PropertyGroup Condition="'$(_SailfishLegPlatform)' == 'sailfish' And '$(_SailfishIsApp)' == 'true'">
    <!-- Device payload by default; self-contained because Sailfish OS has no shared .NET runtime. -->
    <!-- SailfishRuntimeIdentifier picks it for this leg only (tools/sf deploy): a global -r would reach every head. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(SailfishRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- The RPM is this leg's publish artifact; _SailfishRpmDefaulted keeps plain `dotnet build` from warning about it. -->
    <_SailfishRpmDefaulted Condition="'$(CreateSailfishRpm)' == ''">true</_SailfishRpmDefaulted>
    <CreateSailfishRpm Condition="'$(CreateSailfishRpm)' == ''">true</CreateSailfishRpm>
    <!-- Restore can miss a RID that only these targets set (NETSDK1047); _SailfishCheckRestoreHasRid reports it. -->
    <_SailfishAssetsHasRid Condition="'$(RuntimeIdentifier)' != '' and Exists('$(ProjectAssetsFile)')">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)').Contains('$(TargetFramework)/$(RuntimeIdentifier)'))</_SailfishAssetsHasRid>
    <!-- A Platforms/SailfishOS/Program.cs brings its own Main (like Platforms/iOS/Program.cs); otherwise one is generated. -->
    <SailfishGenerateMain Condition="'$(SailfishGenerateMain)' == '' And Exists('$(MSBuildProjectDirectory)/Platforms/SailfishOS/Program.cs')">false</SailfishGenerateMain>
    <SailfishGenerateMain Condition="'$(SailfishGenerateMain)' == ''">true</SailfishGenerateMain>
    <!-- SailfishOrientation / SailfishCover (the author manifest) default with the packaging identity above. -->
  </PropertyGroup>

  <!-- Bakes the metadata the Qt shell reads at startup next to the QML payload. -->
  <!-- SailfishUrlSchemes ("myapp;geo") / SailfishMimeTypes ("text/plain;image/png"): the app opens these. Its D-Bus name is
       OrganizationName.PackageName, the one Sailjail lets a sandboxed app own; interface names cannot hold '-'. -->
  <Target Name="_SailfishOpenUrlNames">
    <PropertyGroup>
      <_SailfishDBusName>$(SailfishOrganizationName).$(SailfishPackageName)</_SailfishDBusName>
      <_SailfishDBusIface>$(_SailfishDBusName.Replace('-', '_'))</_SailfishDBusIface>
      <_SailfishDBusPath>/$(_SailfishDBusIface.Replace('.', '/'))</_SailfishDBusPath>
    </PropertyGroup>
    <ItemGroup>
      <_SailfishUrlScheme Include="$(SailfishUrlSchemes)" />
      <_SailfishMimeType Include="$(SailfishMimeTypes)" />
    </ItemGroup>
  </Target>

  <!-- Also for a plain net11.0 head that opens URLs: the app reads its D-Bus names from the meta. Heads only: a class
       library's copy would land on the same qml/maui-appmeta.json path in the app (NETSDK1152). -->
  <Target Name="_SailfishWriteAppMeta" BeforeTargets="BeforeBuild" DependsOnTargets="_SailfishOpenUrlNames"
          Condition="'$(_SailfishIsApp)' == 'true' And ('$(_SailfishLegPlatform)' == 'sailfish' Or '$(SailfishHarbour)' == 'true' Or '$(SailfishUrlSchemes)$(SailfishMimeTypes)' != '')">
    <Error Condition="'$(SailfishCoverQml)' != '' And !Exists('$(SailfishCoverQml)')"
           Text="SailfishCoverQml '$(SailfishCoverQml)' does not exist (a QML item file relative to the project)." />
    <PropertyGroup>
      <_SailfishCoverQmlRel Condition="'$(SailfishCoverQml)' != ''">cover/AppCover.qml</_SailfishCoverQmlRel>
      <_SailfishOpenUrlMeta Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''">,"dbusName":"$(_SailfishDBusName)","dbusPath":"$(_SailfishDBusPath)","dbusIface":"$(_SailfishDBusIface)"</_SailfishOpenUrlMeta>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectExtensionsPath)maui-appmeta.json"
                      Lines='{"orientation":"$(SailfishOrientation)","cover":$(SailfishCover),"coverQml":"$(_SailfishCoverQmlRel)","title":"$(ApplicationTitle)","sandboxed":$(_SailfishSandboxed),"organization":"$(SailfishOrganizationName)","application":"$(SailfishPackageName)","appId":"$(ApplicationId)","version":"$(ApplicationDisplayVersion)","build":"$(ApplicationVersion)"$(_SailfishOpenUrlMeta)}'
                      Overwrite="true" />
    <ItemGroup>
      <Content Include="$(SailfishCoverQml)" Condition="'$(SailfishCoverQml)' != ''"
               Link="qml/cover/AppCover.qml"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Visible="false" />
      <Content Include="$(MSBuildProjectExtensionsPath)maui-appmeta.json"
               Link="qml/maui-appmeta.json"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <!-- Non-single-project apps include Platforms/SailfishOS explicitly; MAUI single projects get it from the platform-folder hook. -->
    <Compile Include="Platforms/SailfishOS/**/*.cs" Condition="'$(SingleProject)' != 'true'" />
  </ItemGroup>

  <!-- ================= Images, fonts, assets ================= -->
  <!-- MAUI's resizetizer through its external-backend contract (Microsoft.Maui.Resizetizer.After.targets): setting
       ResizetizerPlatformType makes MAUI's own ResizetizeImages / ProcessMauiFonts / ProcessMauiAssets run for this head,
       referenced projects' MauiImage/MauiFont/MauiAsset included, and hand the results over as @(MauiProcessedImage),
       @(MauiProcessedFont) and @(MauiProcessedAsset). The "wpf" layout gives one raster per image: 4x its dp size for the
       ones it resizes, the rest copied as they are. App heads only: a library's items reach the app through its
       ProjectReference, as on the in-box heads. -->
  <PropertyGroup Condition="'$(_SailfishLegPlatform)' == 'sailfish' And '$(_SailfishIsApp)' == 'true'">
    <ResizetizerPlatformType Condition="'$(ResizetizerPlatformType)' == ''">wpf</ResizetizerPlatformType>
    <!-- No head SDK runs them here (Android's does through its resource targets); the Content they produce needs them
         before target paths are assigned. -->
    <ResizetizeBeforeTargets>$(ResizetizeBeforeTargets);AssignTargetPaths</ResizetizeBeforeTargets>
    <ProcessMauiFontsBeforeTargets>$(ProcessMauiFontsBeforeTargets);AssignTargetPaths</ProcessMauiFontsBeforeTargets>
    <ResizetizerAfterImageProcessingTargets>$(ResizetizerAfterImageProcessingTargets);_SailfishMauiProcessedImages</ResizetizerAfterImageProcessingTargets>
    <ResizetizerAfterFontProcessingTargets>$(ResizetizerAfterFontProcessingTargets);_SailfishMauiProcessedFonts</ResizetizerAfterFontProcessingTargets>
    <ResizetizerAfterAssetProcessingTargets>$(ResizetizerAfterAssetProcessingTargets);_SailfishMauiProcessedAssets</ResizetizerAfterAssetProcessingTargets>
  </PropertyGroup>

  <!-- Images land in images/, where QtHostImages probes. The app icon (a MauiIcon becomes a MauiImage with IsAppIcon)
       feeds the hicolor icon set instead (_CopySailfishRpmIcon). maui-resized.txt lists the 4x rasters, so Image
       measures them as Android does (the resizetizer's own rule: an SVG, or a bitmap with BaseSize or Resize="true"). -->
  <Target Name="_SailfishMauiProcessedImages">
    <ItemGroup>
      <_SailfishAppIconName Include="@(MauiIcon->'%(Filename)')" />
      <_SailfishAppIconImage Include="@(MauiProcessedImage)" Condition="'@(_SailfishAppIconName)' != '' And '%(Filename)' == '@(_SailfishAppIconName)'" />
      <_SailfishImage Include="@(MauiProcessedImage)" Exclude="@(_SailfishAppIconImage)" />
      <_SailfishResizedImage Include="@(MauiImage)" Condition="'%(MauiImage.IsAppIcon)' != 'True' And '%(MauiImage.Extension)' != '.gif' And ('%(MauiImage.Resize)' == 'true' Or ('%(MauiImage.Resize)' == '' And ('%(MauiImage.BaseSize)' != '' Or '%(MauiImage.Extension)' == '.svg')))" />
      <_SailfishResizedName Include="$([System.IO.Path]::GetFileNameWithoutExtension('%(_SailfishResizedImage.Link)'))" Condition="'%(_SailfishResizedImage.Link)' != ''" />
      <_SailfishResizedName Include="%(_SailfishResizedImage.Filename)" Condition="'%(_SailfishResizedImage.Link)' == ''" />
    </ItemGroup>
    <PropertyGroup>
      <_SailfishResizedList>$(IntermediateOutputPath)sailfish-images/maui-resized.txt</_SailfishResizedList>
      <_SailfishAppIconSource Condition="'@(_SailfishAppIconImage)' != ''">%(_SailfishAppIconImage.FullPath)</_SailfishAppIconSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SailfishResizedList)" Lines="@(_SailfishResizedName->Distinct())" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="@(_SailfishImage)" Link="images/%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
      <Content Include="$(_SailfishResizedList)" Link="images/maui-resized.txt"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
      <FileWrites Include="$(_SailfishResizedList)" />
      <_SailfishAppIconName Remove="@(_SailfishAppIconName)" />
      <_SailfishImage Remove="@(_SailfishImage)" />
      <_SailfishResizedImage Remove="@(_SailfishResizedImage)" />
      <_SailfishResizedName Remove="@(_SailfishResizedName)" />
    </ItemGroup>
  </Target>

  <!-- Fonts land in fonts/, where QtHostFonts registers them. -->
  <Target Name="_SailfishMauiProcessedFonts">
    <ItemGroup>
      <Content Include="@(MauiProcessedFont)" Link="fonts/%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- MauiAsset goes to its LogicalName (or file name) under the app root, as on the in-box heads (Resources/Raw keeps its
       subfolders); MAUI resolves that path into Link. FileSystem.OpenAppPackageFileAsync and file image sources read it there. -->
  <Target Name="_SailfishMauiProcessedAssets">
    <ItemGroup>
      <Content Include="@(MauiProcessedAsset)" Link="$([System.String]::Copy('%(MauiProcessedAsset.Link)').Replace('\','/'))"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Registers Platforms/SailfishOS/ with MAUI's external-backend hook; MauiActiveBackend matches after the identifier is cleared. -->
  <PropertyGroup Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <MauiActiveBackend Condition="'$(MauiActiveBackend)' == ''">sailfish</MauiActiveBackend>
  </PropertyGroup>
  <ItemGroup>
    <MauiPlatformSpecificFolder Include="Platforms/SailfishOS/" TargetPlatformIdentifier="sailfish" BackendIdentity="sailfish" />
  </ItemGroup>

  <!-- Clears the platform identifier so the SDK does not turn MAUI packages into FrameworkReferences (NETSDK1073/1186); restore has already used it. -->
  <Target Name="_SailfishDefuseMauiFrameworkConversion" BeforeTargets="ProcessFrameworkReferences"
          Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <PropertyGroup>
      <TargetPlatformIdentifier></TargetPlatformIdentifier>
    </PropertyGroup>
  </Target>

  <!-- Puts the platform back once the framework references are resolved, so what the SDK keys on it afterwards still
       happens: the SAILFISH1_0/SAILFISH1_0_OR_GREATER defines and the TargetPlatform/SupportedOSPlatform("sailfish1.0")
       assembly attributes. -->
  <Target Name="_SailfishRestorePlatformIdentifier" AfterTargets="ProcessFrameworkReferences"
          Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <PropertyGroup>
      <TargetPlatformIdentifier>sailfish</TargetPlatformIdentifier>
    </PropertyGroup>
  </Target>

  <!-- ================= Generated entry point ================= -->
  <!-- With SailfishGenerateMain the app ships no Main; the scaffold finds a public static CreateMauiApp(). -->
  <PropertyGroup>
    <SailfishGenerateMain Condition="'$(SailfishGenerateMain)' == ''">false</SailfishGenerateMain>
  </PropertyGroup>

  <ItemGroup Condition="'$(SailfishGenerateMain)' == 'true' And '$(_SailfishIsApp)' == 'true' And ('$(_SailfishLegPlatform)' == '' Or '$(_SailfishLegPlatform)' == 'sailfish')">
    <Compile Include="$(MSBuildThisFileDirectory)../scaffold/SailfishGeneratedEntryPoint.cs"
             Link="SailfishGeneratedEntryPoint.cs" Visible="false" />
  </ItemGroup>

  <!-- The generated Main finds CreateMauiApp() through reflection; a trimmed publish keeps it on the app's *MauiProgram
       types. The descriptor names the app assembly, so no other assembly's types are rooted (it matters under
       TrimMode=full; partial copies the app untrimmed). -->
  <Target Name="_SailfishTrimmerDescriptor" BeforeTargets="PrepareForILLink"
          Condition="'$(SailfishGenerateMain)' == 'true' And '$(_SailfishIsApp)' == 'true' And ('$(_SailfishLegPlatform)' == '' Or '$(_SailfishLegPlatform)' == 'sailfish')">
    <PropertyGroup>
      <_SailfishTrimmerDescriptor>$(IntermediateOutputPath)sailfish-trimmer.xml</_SailfishTrimmerDescriptor>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SailfishTrimmerDescriptor)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;linker&gt;;  &lt;assembly fullname=&quot;$(AssemblyName)&quot;&gt;;    &lt;type fullname=&quot;*MauiProgram&quot; preserve=&quot;methods&quot; /&gt;;  &lt;/assembly&gt;;&lt;/linker&gt;" />
    <ItemGroup>
      <TrimmerRootDescriptor Include="$(_SailfishTrimmerDescriptor)" />
      <FileWrites Include="$(_SailfishTrimmerDescriptor)" />
    </ItemGroup>
  </Target>

  <!-- ================= Native assets of a checkout app ================= -->
  <!-- A package consumer gets the shim, the launcher and the secrets bridge as NuGet runtime assets. An app that
       references the backend by project (the repo's Sample) gets none that way, so it names the tools/sf
       native-build output instead: SailfishNativeAssetsDir (artifacts/native); the RID picks the arch. -->
  <PropertyGroup Condition="'$(SailfishNativeAssetsDir)' != ''">
    <_SailfishNativeArch Condition="'$(RuntimeIdentifier)' == 'linux-arm'">armv7hl</_SailfishNativeArch>
    <_SailfishNativeArch Condition="'$(_SailfishNativeArch)' == ''">aarch64</_SailfishNativeArch>
    <_SailfishNativeDir>$([MSBuild]::EnsureTrailingSlash('$(SailfishNativeAssetsDir)'))$(_SailfishNativeArch)/</_SailfishNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(SailfishNativeAssetsDir)' != ''">
    <Content Include="$(_SailfishNativeDir)libsailfishhost.so" Link="libsailfishhost.so"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(_SailfishNativeDir)libsailfishhost.so')" />
    <Content Include="$(_SailfishNativeDir)sailfish-launcher" Link="sailfish-launcher"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(_SailfishNativeDir)sailfish-launcher')" />
    <Content Include="$(_SailfishNativeDir)libsailfishsecretsbridge.so" Link="libsailfishsecretsbridge.so"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(_SailfishNativeDir)libsailfishsecretsbridge.so')" />
  </ItemGroup>

  <!-- ================= Property Defaults ================= -->
  <PropertyGroup Condition="'$(CreateSailfishRpm)' == 'true'">
    <_SailfishRpmEnabled>true</_SailfishRpmEnabled>

    <!-- Metadata from MAUI conventions -->
    <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(AssemblyName)</ApplicationTitle>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">$(Version)</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0.0</ApplicationDisplayVersion>

    <!-- harbour- + last ApplicationId segment -->
    <_SailfishNameFromId>$([System.Text.RegularExpressions.Regex]::Replace('$(ApplicationId)', '^.*\.', ''))</_SailfishNameFromId>
    <SailfishPackageName Condition="'$(SailfishPackageName)' == ''">harbour-$(_SailfishNameFromId.ToLowerInvariant())</SailfishPackageName>

    <SailfishVersion Condition="'$(SailfishVersion)' == ''">$(ApplicationDisplayVersion)</SailfishVersion>
    <SailfishRelease Condition="'$(SailfishRelease)' == ''">1</SailfishRelease>
    <SailfishSummary Condition="'$(SailfishSummary)' == ''">$(ApplicationTitle)</SailfishSummary>
    <SailfishDescription Condition="'$(SailfishDescription)' == ''">$(Description)</SailfishDescription>
    <SailfishDescription Condition="'$(SailfishDescription)' == ''">$(ApplicationTitle) built with .NET MAUI</SailfishDescription>
    <SailfishVendor Condition="'$(SailfishVendor)' == ''">$(Authors)</SailfishVendor>
    <SailfishVendor Condition="'$(SailfishVendor)' == ''">MAUI Developer</SailfishVendor>
    <SailfishLicense Condition="'$(SailfishLicense)' == ''">$(PackageLicenseExpression)</SailfishLicense>
    <SailfishLicense Condition="'$(SailfishLicense)' == ''">MIT</SailfishLicense>
    <SailfishUrl Condition="'$(SailfishUrl)' == ''">$(PackageProjectUrl)</SailfishUrl>

    <!-- Harbour RPM architecture mapping from RID -->
    <_SailfishRidArch>$([System.Text.RegularExpressions.Regex]::Match('$(RuntimeIdentifier)', 'linux-(.+)').Groups[1].Value)</_SailfishRidArch>
    <SailfishRpmArch Condition="'$(SailfishRpmArch)' == '' and '$(_SailfishRidArch)' == 'x64'">x86_64</SailfishRpmArch>
    <SailfishRpmArch Condition="'$(SailfishRpmArch)' == '' and '$(_SailfishRidArch)' == 'arm64'">aarch64</SailfishRpmArch>
    <SailfishRpmArch Condition="'$(SailfishRpmArch)' == '' and '$(_SailfishRidArch)' == 'arm'">armv7hl</SailfishRpmArch>
    <!-- Full triple so rpmbuild stamps OS=linux even on macOS -->
    <SailfishRpmTarget Condition="'$(SailfishRpmTarget)' == ''">$(SailfishRpmArch)-unknown-linux-gnu</SailfishRpmTarget>

    <!-- Output -->
    <SailfishRpmOutputDir Condition="'$(SailfishRpmOutputDir)' == ''">$(MSBuildProjectDirectory)/bin/SailfishRpm</SailfishRpmOutputDir>
    <SailfishRpmFileName Condition="'$(SailfishRpmFileName)' == ''">$(SailfishPackageName)-$(SailfishVersion)-$(SailfishRelease).$(SailfishRpmArch).rpm</SailfishRpmFileName>

    <!-- Install paths (inside the RPM) -->
    <_SailfishInstallPrefix>/usr/share/$(SailfishPackageName)</_SailfishInstallPrefix>

    <!-- Working directories -->
    <_SailfishWorkDir>$(MSBuildProjectDirectory)/obj/SailfishRpm/$(SailfishPackageName)-$(SailfishVersion)-$(SailfishRelease).$(SailfishRpmArch)</_SailfishWorkDir>
    <_SailfishBuildRoot>$(_SailfishWorkDir)/buildroot</_SailfishBuildRoot>
    <_SailfishTopDir>$(_SailfishWorkDir)/topdir</_SailfishTopDir>
    <_SailfishSpecFile>$(_SailfishWorkDir)/$(SailfishPackageName).spec</_SailfishSpecFile>
  </PropertyGroup>

  <!-- ================= Release payload profile ================= -->
  <!-- SailfishTrim / SailfishReadyToRun payload profiles (docs/aot-and-trimming.md). NativeAOT is not supported: see _ValidateSailfishAotPolicy. -->
  <PropertyGroup>
    <!-- Release defaults to trim+R2R; Debug stays untrimmed and JIT-only for debuggability. -->
    <SailfishTrim Condition="'$(SailfishTrim)' == '' and '$(Configuration)' == 'Release'">true</SailfishTrim>
    <SailfishTrim Condition="'$(SailfishTrim)' == ''">false</SailfishTrim>
    <SailfishReadyToRun Condition="'$(SailfishReadyToRun)' == '' and '$(Configuration)' == 'Release'">true</SailfishReadyToRun>
    <SailfishReadyToRun Condition="'$(SailfishReadyToRun)' == ''">false</SailfishReadyToRun>
    <SailfishTrimMode Condition="'$(SailfishTrimMode)' == ''">partial</SailfishTrimMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SailfishTrim)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>$(SailfishTrimMode)</TrimMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SailfishReadyToRun)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Runtime feature switches of a trimmed publish, aligned with the Android head (Microsoft.Android.Sdk's
       DefaultProperties.targets) so app code behaves as it does there; the full table, including the switches kept
       different on purpose, is in docs/aot-and-trimming.md §2.5. These run before the ILLink targets' defaults. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true' And '$(TrimMode)' == 'partial'">
    <!-- Reflection-based System.Text.Json (GetFromJsonAsync<T>, Deserialize<T> without a JsonSerializerContext). The SDK
         turns it off for every trimmed app; partial trimming keeps the app's and libraries' types, so it works. -->
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' == ''">true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- [DefaultValue] keeps working instead of throwing (dotnet/runtime#109724). -->
    <_DefaultValueAttributeSupport Condition="'$(_DefaultValueAttributeSupport)' == ''">true</_DefaultValueAttributeSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- A development-time check of DI open generics; production builds skip its startup cost. -->
    <VerifyDependencyInjectionOpenGenericServiceTrimmability Condition="'$(VerifyDependencyInjectionOpenGenericServiceTrimmability)' == ''">false</VerifyDependencyInjectionOpenGenericServiceTrimmability>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true' And '$(Optimize)' == 'true'">
    <StartupHookSupport Condition="'$(StartupHookSupport)' == ''">false</StartupHookSupport>
    <HttpActivityPropagationSupport Condition="'$(HttpActivityPropagationSupport)' == ''">false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <!-- The SDK regenerates the publish deps.json only when the project or assets files change, not when the trimmer keeps
       another framework assembly. A code change whose first use of a facade (System.Threading.Thread) comes with an
       incremental trimmed publish shipped the facade without a deps.json entry: FileNotFoundException at that first use
       (tracker S61). Trimmed publishes always rebuild it (well under a second). -->
  <Target Name="_SailfishRegenerateTrimmedDepsFile"
          BeforeTargets="GeneratePublishDependencyFile"
          DependsOnTargets="_ComputeIntermediateDepsFilePath"
          Condition="'$(PublishTrimmed)' == 'true' and '$(PublishAot)' != 'true'">
    <Delete Files="$(IntermediateDepsFilePath)" />
  </Target>

  <!-- TieredPGO off: it re-jits hot R2R code after launch and costs idle CPU. SailfishTieredCompilation=false drops re-jitting entirely. -->
  <PropertyGroup>
    <TieredPGO Condition="'$(TieredPGO)' == ''">false</TieredPGO>
    <TieredCompilation Condition="'$(TieredCompilation)' == '' and '$(SailfishTieredCompilation)' == 'false'">false</TieredCompilation>
  </PropertyGroup>

  <!-- MAUI's layout instrumentation (an ActivitySource span with a tag list per Measure/Arrange) runs whenever Meter is
       supported. Release turns System.Diagnostics.Metrics off (SailfishMetrics=false → MetricsSupport=false): no per-layout
       cost; dotnet-counters falls back to the runtime's EventCounters. SailfishMetrics=true keeps Meter in Release. -->
  <PropertyGroup>
    <SailfishMetrics Condition="'$(SailfishMetrics)' == '' and '$(Configuration)' == 'Release'">false</SailfishMetrics>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SailfishMetrics)' == 'false'">
    <MetricsSupport Condition="'$(MetricsSupport)' == ''">false</MetricsSupport>
  </PropertyGroup>

  <!-- The RPM carries only what runs on the phone. SailfishRpmDebugPayload (default: Debug only) keeps what a debugger
       needs: PDBs, the NativeAOT .dbg, the DAC/DBI pair (vsdbg, SOS) and createdump. Release attach sets it to true. -->
  <PropertyGroup>
    <SailfishRpmDebugPayload Condition="'$(SailfishRpmDebugPayload)' == '' and '$(Configuration)' == 'Debug'">true</SailfishRpmDebugPayload>
    <SailfishRpmDebugPayload Condition="'$(SailfishRpmDebugPayload)' == ''">false</SailfishRpmDebugPayload>
  </PropertyGroup>
  <!-- The invariant culture never loads a satellite assembly, so MAUI's resource dlls (30+ cultures) are dead weight. -->
  <PropertyGroup Condition="'$(InvariantGlobalization)' == 'true' And ('$(_SailfishLegPlatform)' == '' Or '$(_SailfishLegPlatform)' == 'sailfish')">
    <SatelliteResourceLanguages Condition="'$(SatelliteResourceLanguages)' == ''">en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Restore normally gets the RID from the workload manifest; when the assets still lack it (manifest missing or
       older, RID only set here), say which restore fixes it instead of restoring from inside the build. -->
  <Target Name="_SailfishCheckRestoreHasRid"
          Condition="'$(_SailfishLegPlatform)' == 'sailfish' and '$(_SailfishIsApp)' == 'true' and '$(RuntimeIdentifier)' != '' and Exists('$(ProjectAssetsFile)') and '$(_SailfishAssetsHasRid)' != 'true'"
          BeforeTargets="ResolvePackageAssets">
    <Error Code="SAILFISH0001"
           Text="The restore of $(MSBuildProjectFile) has no $(TargetFramework)/$(RuntimeIdentifier) target (NETSDK1047 would follow). Restore with the RID: dotnet restore &quot;$(MSBuildProjectFullPath)&quot; -p:SailfishRuntimeIdentifier=$(RuntimeIdentifier) (this head only, unlike -r) — or install the workload manifest, which sets it for every restore: dnx Microsoft.Maui.Platforms.SailfishOS.Workload install" />
  </Target>

  <!-- ================= Validate Properties ================= -->
  <Target Name="_ValidateSailfishRpmProperties"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          BeforeTargets="CreateSailfishRpm">

    <Error Condition="'$(ApplicationId)' == ''"
           Text="Sailfish RPM packaging requires the ApplicationId property to be set in your project file." />

    <Error Condition="'$(RuntimeIdentifier)' == ''"
           Text="Sailfish RPM packaging requires a RuntimeIdentifier. Use: dotnet publish -r linux-x64 -p:SelfContained=true -p:CreateSailfishRpm=true" />

    <Error Condition="!$(RuntimeIdentifier.StartsWith('linux-'))"
           Text="Sailfish RPM packaging only supports Linux RuntimeIdentifiers (linux-x64, linux-arm64, linux-arm)." />

    <!-- An RID without a known RPM arch used to build an x86_64 RPM silently. -->
    <Error Condition="'$(SailfishRpmArch)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))"
           Text="No RPM architecture for RuntimeIdentifier '$(RuntimeIdentifier)': Sailfish OS has linux-arm64 (aarch64), linux-arm (armv7hl) and linux-x64 (x86_64); set SailfishRpmArch to package another." />

    <Error Condition="!$(SailfishPackageName.StartsWith('harbour-'))"
           Text="Sailfish harbour packages must be named harbour-*. Set the SailfishPackageName property to a harbour- prefixed name." />

    <Error Condition="'$(SelfContained)' != 'true'"
           Text="Sailfish RPM packaging requires self-contained publish. Add -p:SelfContained=true to your dotnet publish command." />
  </Target>

  <!-- Must fail before ILC, which runs as a Publish dependency; a Publish hook would surface a linker error instead. -->
  <Target Name="_ValidateSailfishAotPolicy"
          Condition="'$(PublishAot)' == 'true'"
          BeforeTargets="Build;Publish;CreateSailfishRpm">

    <Error Text="PublishAot is not supported by this backend yet (gate G2 in docs/aot-and-trimming.md): ILC cannot link a linux-arm64 ELF on a macOS build host, and the AOT payload has no DAC/DBI, so there is no vsdbg/SOS/hot reload. Use -p:SailfishTrim=true -p:SailfishReadyToRun=true instead." />
  </Target>

  <!-- On Publish because the RID is resolved by then; a RID-less publish would otherwise build a host-RID payload. -->
  <Target Name="_ValidateSailfishReleaseProfile"
          Condition="'$(SailfishTrim)' == 'true' or '$(SailfishReadyToRun)' == 'true'"
          BeforeTargets="Publish;CreateSailfishRpm">

    <Error Condition="'$(RuntimeIdentifier)' == ''"
           Text="SailfishTrim/SailfishReadyToRun require a RuntimeIdentifier. Use: dotnet publish -r linux-arm64 -p:SelfContained=true" />

    <Error Condition="!$(RuntimeIdentifier.StartsWith('linux-'))"
           Text="The Sailfish payload profiles only support Linux RuntimeIdentifiers (linux-x64, linux-arm64, linux-arm); got '$(RuntimeIdentifier)'. Pass -r explicitly." />

    <Error Condition="'$(SelfContained)' != 'true'"
           Text="SailfishTrim/SailfishReadyToRun require a self-contained publish. Add -p:SelfContained=true to your dotnet publish command." />

    <Message Importance="high"
             Text="Sailfish: payload profile trim=$(SailfishTrim) trimMode=$(SailfishTrimMode) readyToRun=$(SailfishReadyToRun)" />
  </Target>

  <!-- ================= Prepare Staging Directory ================= -->
  <Target Name="_PrepareSailfishRpmStaging"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          BeforeTargets="CreateSailfishRpm"
          DependsOnTargets="_ValidateSailfishRpmProperties">

    <!-- Clean and create the rpmbuild structure -->
    <RemoveDir Directories="$(_SailfishWorkDir)" />
    <MakeDir Directories="$(_SailfishBuildRoot)$(_SailfishInstallPrefix)" />
    <MakeDir Directories="$(_SailfishBuildRoot)/usr/bin" />
    <MakeDir Directories="$(_SailfishBuildRoot)/usr/share/applications" />
    <MakeDir Directories="$(_SailfishBuildRoot)/usr/share/icons/hicolor/108x108/apps" />
    <MakeDir Directories="$(_SailfishTopDir)/BUILD" />
    <MakeDir Directories="$(_SailfishTopDir)/RPMS" />
    <MakeDir Directories="$(_SailfishTopDir)/SOURCES" />
    <MakeDir Directories="$(_SailfishTopDir)/SPECS" />
    <MakeDir Directories="$(_SailfishTopDir)/SRPMS" />

    <!-- Publish output goes to /usr/share/PKG/; Harbour: /usr/share/PKG/lib/ without the apphost (the launcher starts the app). -->
    <ItemGroup>
      <_SailfishPublishFiles Include="$(PublishDir)**/*" />
      <!-- Never loaded on the phone: the LTTng provider (no liblttng-ust on Sailfish OS; Harbour disallows it) and the
           standalone GCs (only with DOTNET_GCName). The launcher is copied to /usr/bin straight from PublishDir. -->
      <_SailfishPublishFiles Remove="$(PublishDir)libcoreclrtraceptprovider.so;$(PublishDir)libclrgc.so;$(PublishDir)libclrgcexp.so;$(PublishDir)sailfish-launcher" />
      <_SailfishPublishFiles Remove="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg;$(PublishDir)createdump;$(PublishDir)libmscordaccore.so;$(PublishDir)libmscordbi.so"
                             Condition="'$(SailfishRpmDebugPayload)' != 'true'" />
      <_SailfishPublishFiles Remove="$(PublishDir)$(AssemblyName);$(PublishDir)createdump"
                             Condition="'$(SailfishHarbour)' == 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <_SailfishPayloadDir>$(_SailfishBuildRoot)$(_SailfishInstallPrefix)</_SailfishPayloadDir>
      <_SailfishPayloadDir Condition="'$(SailfishHarbour)' == 'true'">$(_SailfishBuildRoot)$(_SailfishInstallPrefix)/lib</_SailfishPayloadDir>
    </PropertyGroup>
    <Error Condition="'$(SailfishHarbour)' == 'true' And '$(_SailfishSandboxed)' != 'true'"
           Text="SailfishHarbour=true needs a sandboxed app: drop SailfishSandboxing=false — Harbour rejects Sandboxing=Disabled." />
    <Error Condition="'$(SailfishHarbour)' == 'true' And !Exists('$(PublishDir)sailfish-launcher')"
           Text="SailfishHarbour=true needs the native launcher (sailfish-launcher) in the publish output — build it with tools/sf native-build or reference a Microsoft.Maui.Platforms.SailfishOS package that carries runtimes/$(RuntimeIdentifier)/native/sailfish-launcher." />

    <Copy SourceFiles="@(_SailfishPublishFiles)"
          DestinationFiles="@(_SailfishPublishFiles->'$(_SailfishPayloadDir)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="normal" Text="SailfishRpm: Prepared staging directory at $(_SailfishBuildRoot)" />
  </Target>

  <!-- Writes the per-app rpath into the prebuilt launcher's placeholder DT_RPATH (NUL-padded, same length). -->
  <!-- Compiled tasks (src/Linux.SailfishOS.Build.Tasks): packed next to this file; a checkout that imports the targets from
       src/ uses the build output in artifacts/build-tasks. Out of process, so no MSBuild node keeps the dll locked. -->
  <PropertyGroup>
    <SailfishBuildTasksAssembly Condition="'$(SailfishBuildTasksAssembly)' == '' And Exists('$(MSBuildThisFileDirectory)tasks/Microsoft.Maui.SailfishOS.Build.Tasks.dll')">$(MSBuildThisFileDirectory)tasks/Microsoft.Maui.SailfishOS.Build.Tasks.dll</SailfishBuildTasksAssembly>
    <SailfishBuildTasksAssembly Condition="'$(SailfishBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/build-tasks/Microsoft.Maui.SailfishOS.Build.Tasks.dll</SailfishBuildTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="Microsoft.Maui.SailfishOS.Build.Tasks.SailfishPatchLauncherRpath"
             AssemblyFile="$(SailfishBuildTasksAssembly)" TaskFactory="TaskHostFactory" />

  <!-- ================= Generate Launcher (symlink to ELF binary) ================= -->
  <!-- invoker + sailjail require /usr/bin/PKG to be an ELF (a script is killed), so it is a symlink to the apphost or the native launcher. -->
  <Target Name="_GenerateSailfishRpmLauncher"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          AfterTargets="_PrepareSailfishRpmStaging"
          BeforeTargets="CreateSailfishRpm">

    <Exec Command="chmod +x '$(_SailfishBuildRoot)$(_SailfishInstallPrefix)/$(AssemblyName)'" Condition="'$(SailfishHarbour)' != 'true' And Exists('$(_SailfishBuildRoot)$(_SailfishInstallPrefix)/$(AssemblyName)')" />

    <!-- Relative symlink avoids rpmbuild's absolute-symlink warning -->
    <Exec Command="ln -sf '../share/$(SailfishPackageName)/$(AssemblyName)' '$(_SailfishBuildRoot)/usr/bin/$(SailfishPackageName)'" Condition="'$(SailfishHarbour)' != 'true'" />

    <!-- Harbour: the native launcher is /usr/bin/PKG with rpath to the package lib dir; non-ELF payload files must not be executable. -->
    <Copy SourceFiles="$(PublishDir)sailfish-launcher" DestinationFiles="$(_SailfishBuildRoot)/usr/bin/$(SailfishPackageName)" Condition="'$(SailfishHarbour)' == 'true'" />
    <SailfishPatchLauncherRpath File="$(_SailfishBuildRoot)/usr/bin/$(SailfishPackageName)"
                                Rpath="$ORIGIN/../share/$(SailfishPackageName)/lib"
                                Condition="'$(SailfishHarbour)' == 'true'" />
    <Exec Command="chmod 0755 '$(_SailfishBuildRoot)/usr/bin/$(SailfishPackageName)'" Condition="'$(SailfishHarbour)' == 'true'" />
    <Exec Command="find '$(_SailfishBuildRoot)$(_SailfishInstallPrefix)/lib' -type f -exec chmod 0644 {} + &amp;&amp; find '$(_SailfishBuildRoot)$(_SailfishInstallPrefix)/lib' -type f -name '*.so*' -exec chmod 0755 {} +"
          Condition="'$(SailfishHarbour)' == 'true'" />

    <Message Importance="normal" Text="SailfishRpm: /usr/bin/$(SailfishPackageName) → ../share/$(SailfishPackageName)/$(AssemblyName)" Condition="'$(SailfishHarbour)' != 'true'" />
    <Message Importance="normal" Text="SailfishRpm: /usr/bin/$(SailfishPackageName) = native launcher (Harbour profile)" Condition="'$(SailfishHarbour)' == 'true'" />
  </Target>

  <!-- ================= Generate .desktop File ================= -->
  <Target Name="_GenerateSailfishRpmDesktopFile"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          DependsOnTargets="_CopySailfishRpmIcon;_SailfishOpenUrlNames"
          AfterTargets="_PrepareSailfishRpmStaging"
          BeforeTargets="CreateSailfishRpm">

    <PropertyGroup>
      <!-- Absolute icon path, since lipstick's theme lookup can miss hicolor icons. SailfishSandboxing=false opts out via [X-Sailjail] Sandboxing=Disabled;
           otherwise ';' in Permissions is escaped as %3B because WriteLinesToFile splits Lines on ';'. A sandboxed app must name its organization and application. -->
      <_SailfishIconKey>/usr/share/icons/hicolor/108x108/apps/$(SailfishPackageName).png</_SailfishIconKey>
      <_SailfishIconKey Condition="'$(_SailfishDesktopIconPath)' != ''">$(_SailfishDesktopIconPath)</_SailfishIconKey>
      <!-- Harbour: icon by theme name and the booster type -->
      <_SailfishIconKey Condition="'$(SailfishHarbour)' == 'true'">$(SailfishPackageName)</_SailfishIconKey>
      <_SailfishAppTypeLine Condition="'$(SailfishHarbour)' == 'true'">X-Nemo-Application-Type=silica-qt5</_SailfishAppTypeLine>
      <_SailfishSailjailSection Condition="'$(_SailfishSandboxed)' != 'true'">[X-Sailjail]
Sandboxing=Disabled</_SailfishSailjailSection>
      <_SailfishSailjailSection Condition="'$(_SailfishSandboxed)' == 'true'">[X-Sailjail]
Permissions=$(_SailfishPermissions.Replace(';', '%3B'))
OrganizationName=$(SailfishOrganizationName)
ApplicationName=$(SailfishPackageName)</_SailfishSailjailSection>
      <!-- A Debug build installs next to the Release one, so label its launcher entry. -->
      <_SailfishDesktopName>$(ApplicationTitle)</_SailfishDesktopName>
      <_SailfishDesktopName Condition="'$(Configuration)' == 'Debug'">$(ApplicationTitle) (Debug)</_SailfishDesktopName>
      <!-- Opening URLs/files: the content action calls X-Maemo-Method on a running instance (D-Bus activation starts
           it otherwise); %U hands them to a plain launch. ';' is %3B for WriteLinesToFile. -->
      <_SailfishExecArgs Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''"> %25U</_SailfishExecArgs>
      <_SailfishOpenUrlLines Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''">MimeType=@(_SailfishUrlScheme->'x-scheme-handler/%(Identity)%3B', '')@(_SailfishMimeType->'%(Identity)%3B', '')
X-Maemo-Service=$(_SailfishDBusName)
X-Maemo-Object-Path=$(_SailfishDBusPath)
X-Maemo-Method=$(_SailfishDBusIface).openUrl</_SailfishOpenUrlLines>
      <_SailfishDesktopContent>[Desktop Entry]
Type=Application
Name=$(_SailfishDesktopName)
Exec=$(SailfishPackageName)$(_SailfishExecArgs)
Icon=$(_SailfishIconKey)
Terminal=false
$(_SailfishAppTypeLine)
$(_SailfishOpenUrlLines)

$(_SailfishSailjailSection)
</_SailfishDesktopContent>
    </PropertyGroup>

    <WriteLinesToFile File="$(_SailfishBuildRoot)/usr/share/applications/$(SailfishPackageName).desktop"
                      Lines="$(_SailfishDesktopContent)"
                      Overwrite="true" />

    <!-- D-Bus activation: a URL for an app that is not running starts it through the same launcher. -->
    <PropertyGroup Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''">
      <_SailfishInvokerType>generic</_SailfishInvokerType>
      <_SailfishInvokerType Condition="'$(SailfishHarbour)' == 'true'">silica-qt5</_SailfishInvokerType>
      <_SailfishDBusServiceContent>[D-BUS Service]
Name=$(_SailfishDBusName)
Exec=/usr/bin/invoker --type=$(_SailfishInvokerType) --single-instance --desktop-file=$(SailfishPackageName).desktop /usr/bin/$(SailfishPackageName)
</_SailfishDBusServiceContent>
    </PropertyGroup>
    <MakeDir Directories="$(_SailfishBuildRoot)/usr/share/dbus-1/services" Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''" />
    <WriteLinesToFile File="$(_SailfishBuildRoot)/usr/share/dbus-1/services/$(_SailfishDBusName).service"
                      Lines="$(_SailfishDBusServiceContent)"
                      Overwrite="true"
                      Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''" />

    <Message Importance="normal" Text="SailfishRpm: Generated .desktop file" />
  </Target>

  <!-- ================= App icons ================= -->
  <!-- Resamples the square MauiIcon PNG to each hicolor size in plain C#, so packaging needs neither Python nor System.Drawing. -->
  <UsingTask TaskName="Microsoft.Maui.SailfishOS.Build.Tasks.SailfishIconSet"
             AssemblyFile="$(SailfishBuildTasksAssembly)" TaskFactory="TaskHostFactory" />

  <Target Name="_CopySailfishRpmIcon"
          Condition="'$(_SailfishRpmEnabled)' == 'true' and '@(MauiIcon)' != ''"
          AfterTargets="_PrepareSailfishRpmStaging"
          BeforeTargets="CreateSailfishRpm">

    <PropertyGroup>
      <!-- Prefer the resizetizer-composed icon when it was built -->
      <_SailfishIconSource>%(MauiIcon.Identity)</_SailfishIconSource>
      <_SailfishIconSource Condition="'$(_SailfishAppIconSource)' != '' And Exists('$(_SailfishAppIconSource)')">$(_SailfishAppIconSource)</_SailfishIconSource>
    </PropertyGroup>
    <SailfishIconSet Source="$(_SailfishIconSource)" HicolorDir="$(_SailfishBuildRoot)/usr/share/icons/hicolor"
                     Name="$(SailfishPackageName)" Sizes="$(SailfishIconSizes)"
                     Condition="'$(SailfishSkipIconCheck)' != 'true'">
      <Output TaskParameter="Files" ItemName="_SailfishIconFiles" />
    </SailfishIconSet>

    <!-- Bypass: copy the MauiIcon as the 108 px icon, unvalidated -->
    <Copy SourceFiles="@(MauiIcon->'%(Identity)')"
          DestinationFiles="$(_SailfishBuildRoot)/usr/share/icons/hicolor/108x108/apps/$(SailfishPackageName).png"
          Condition="'$(SailfishSkipIconCheck)' == 'true'" />
    <ItemGroup Condition="'$(SailfishSkipIconCheck)' == 'true'">
      <_SailfishIconFiles Include="/usr/share/icons/hicolor/108x108/apps/$(SailfishPackageName).png" />
    </ItemGroup>

    <!-- lipstick caches icons by path, so outside Harbour the .desktop points at a copy named after the icon's hash. -->
    <PropertyGroup>
      <_SailfishIcon108>$(_SailfishBuildRoot)/usr/share/icons/hicolor/108x108/apps/$(SailfishPackageName).png</_SailfishIcon108>
    </PropertyGroup>
    <GetFileHash Files="$(_SailfishIcon108)" Algorithm="SHA256"
                 Condition="'$(SailfishHarbour)' != 'true' And Exists('$(_SailfishIcon108)')">
      <Output TaskParameter="Hash" PropertyName="_SailfishIconHash" />
    </GetFileHash>
    <PropertyGroup Condition="'$(_SailfishIconHash)' != ''">
      <_SailfishDesktopIconPath>$(_SailfishInstallPrefix)/appicon-$([System.String]::Copy('$(_SailfishIconHash)').Substring(0, 12).ToLowerInvariant()).png</_SailfishDesktopIconPath>
    </PropertyGroup>
    <Copy SourceFiles="$(_SailfishIcon108)" DestinationFiles="$(_SailfishBuildRoot)$(_SailfishDesktopIconPath)"
          Condition="'$(_SailfishDesktopIconPath)' != ''" />

    <Message Importance="normal" Text="SailfishRpm: app icons @(_SailfishIconFiles->'%(Identity)', ', ')" />
  </Target>

  <!-- ================= Generate Spec File ================= -->
  <Target Name="_GenerateSailfishRpmSpec"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          DependsOnTargets="_SailfishOpenUrlNames"
          AfterTargets="_PrepareSailfishRpmStaging;_GenerateSailfishRpmLauncher;_GenerateSailfishRpmDesktopFile;_CopySailfishRpmIcon"
          BeforeTargets="CreateSailfishRpm">

    <PropertyGroup>
      <_SailfishDBusServiceFile Condition="'$(SailfishUrlSchemes)$(SailfishMimeTypes)' != ''">/usr/share/dbus-1/services/$(_SailfishDBusName).service</_SailfishDBusServiceFile>
      <!-- Harbour rejects a Vendor tag -->
      <_SailfishVendorLine Condition="'$(SailfishHarbour)' != 'true'">Vendor: $(SailfishVendor)</_SailfishVendorLine>
      <!-- Harbour allows only these package names; the daemon pulls in libsailfishsecrets. -->
      <_SailfishRequiresLines Condition="'$(SailfishSecureStorage)' == 'Secrets'">Requires: sailfishsecretsdaemon
Requires: sailfishsecretsdaemon-secretsplugins-default</_SailfishRequiresLines>
      <_SailfishSpecContent>Name: $(SailfishPackageName)
Version: $(SailfishVersion)
Release: $(SailfishRelease)
Summary: $(SailfishSummary)
License: $(SailfishLicense)
$(_SailfishVendorLine)
$(_SailfishRequiresLines)
AutoReqProv: no
%25description
$(SailfishDescription)
%25files
%25defattr(-,root,root,-)
/usr/bin/$(SailfishPackageName)
$(_SailfishInstallPrefix)
/usr/share/applications/$(SailfishPackageName).desktop
$(_SailfishDBusServiceFile)
</_SailfishSpecContent>

      <_SailfishSpecContent Condition="'@(_SailfishIconFiles)' != ''">$(_SailfishSpecContent)@(_SailfishIconFiles->'%(Identity)', '%0A')
</_SailfishSpecContent>
    </PropertyGroup>

    <WriteLinesToFile File="$(_SailfishSpecFile)"
                      Lines="$(_SailfishSpecContent)"
                      Overwrite="true" />

    <Message Importance="normal" Text="SailfishRpm: Generated spec file at $(_SailfishSpecFile)" />
  </Target>

  <!-- ================= Build RPM Package ================= -->
  <!-- Host rpmbuild when present, else the packaged Python fallback with the same command line. -->
  <Target Name="_ResolveSailfishRpmBuilder"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          BeforeTargets="CreateSailfishRpm">
    <Exec Command="command -v rpmbuild" ContinueOnError="WarnAndContinue"
          StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_SailfishRpmbuildProbe" />
    </Exec>
    <PropertyGroup>
      <!-- Packaged: tools/ next to this file; in-repo: the repo root's tools/. -->
      <_SailfishRpmFallbackPy Condition="Exists('$(MSBuildThisFileDirectory)tools/py/sf-rpmbuild.py')">$(MSBuildThisFileDirectory)tools/py/sf-rpmbuild.py</_SailfishRpmFallbackPy>
      <_SailfishRpmFallbackPy Condition="'$(_SailfishRpmFallbackPy)' == ''">$(MSBuildThisFileDirectory)../../../tools/py/sf-rpmbuild.py</_SailfishRpmFallbackPy>
      <_SailfishRpmBuilder Condition="'$(_SailfishRpmbuildProbe)' == '0'">rpmbuild</_SailfishRpmBuilder>
      <_SailfishRpmBuilder Condition="'$(_SailfishRpmbuildProbe)' != '0'">python3 "$(_SailfishRpmFallbackPy)"</_SailfishRpmBuilder>
    </PropertyGroup>
    <Message Importance="high" Text="SailfishRpm: builder = $(_SailfishRpmBuilder)" />
  </Target>

  <Target Name="CreateSailfishRpm"
          Condition="'$(_SailfishRpmEnabled)' == 'true'"
          AfterTargets="Publish"
          DependsOnTargets="_ResolveSailfishRpmBuilder;_ValidateSailfishRpmProperties;_PrepareSailfishRpmStaging;_GenerateSailfishRpmLauncher;_GenerateSailfishRpmDesktopFile;_CopySailfishRpmIcon;_GenerateSailfishRpmSpec">

    <MakeDir Directories="$(SailfishRpmOutputDir)" />

    <PropertyGroup>
      <_SailfishOutputPath>$(SailfishRpmOutputDir)/$(SailfishRpmFileName)</_SailfishOutputPath>
    </PropertyGroup>

    <Message Importance="high" Text="SailfishRpm: Creating $(SailfishRpmFileName)..." />

    <!-- rpmbuild narrates every step; keep it out of a normal publish log (-v n shows it; a failure still fails the
         build through the exit code). -->
    <Exec Command="$(_SailfishRpmBuilder) -bb --target $(SailfishRpmTarget) --buildroot '$(_SailfishBuildRoot)' --define '_topdir $(_SailfishTopDir)' --define '_buildhost localhost' --define '_rpmdir $(SailfishRpmOutputDir)' --define '_rpmfilename %%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}.rpm' '$(_SailfishSpecFile)'"
          StandardOutputImportance="low"
          StandardErrorImportance="normal" />

    <Message Importance="high" Text="SailfishRpm: Created $(_SailfishOutputPath)" />
  </Target>

  <!-- ================= Release signing + store metadata ================= -->
  <!-- Opt-in: SailfishRpmSignKey signs with host rpm (the Python fallback cannot sign); SailfishStoreMetadata writes an OpenRepos-style YAML. -->
  <Target Name="_SignSailfishRpm"
          Condition="'$(SailfishRpmSignKey)' != ''"
          AfterTargets="CreateSailfishRpm">
    <Error Condition="'$(_SailfishRpmBuilder)' != 'rpmbuild' and '$(SailfishRpmSignKey)' != '' and !Exists('$(SailfishRpmOutputDir)/$(SailfishRpmFileName)')"
           Text="Nothing to sign." />
    <Exec Command="rpm --addsign --define '_gpg_name $(SailfishRpmSignKey)' '$(SailfishRpmOutputDir)/$(SailfishRpmFileName)'" />
    <Message Importance="high" Text="SailfishRpm: signed with key $(SailfishRpmSignKey)" />
  </Target>

  <Target Name="_GenerateSailfishStoreMetadata"
          Condition="'$(SailfishStoreMetadata)' == 'true'"
          AfterTargets="CreateSailfishRpm;_SignSailfishRpm">
    <Exec Command="python3 -c &quot;import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())&quot; '$(SailfishRpmOutputDir)/$(SailfishRpmFileName)' > '$(SailfishRpmOutputDir)/$(SailfishRpmFileName).sha256'" />
    <WriteLinesToFile File="$(SailfishRpmOutputDir)/$(SailfishRpmFileName).yaml" Overwrite="true"
                      Lines="name: $(SailfishPackageName);version: $(SailfishVersion);release: $(SailfishRelease);arch: $(SailfishRpmArch);summary: $(ApplicationTitle);description: $(ApplicationTitle) — .NET MAUI app for Sailfish OS;rpm: $(SailfishRpmFileName);sha256: $([System.IO.File]::ReadAllText('$(SailfishRpmOutputDir)/$(SailfishRpmFileName).sha256').Trim())" />
    <Message Importance="high" Text="SailfishRpm: store metadata at $(SailfishRpmOutputDir)/$(SailfishRpmFileName).yaml" />
  </Target>

  <!-- ================= Device run verb ================= -->
  <!-- -t:SailfishRun deploys over SSH and streams the device log; tools come from the repo clone or the package. -->
  <PropertyGroup>
    <SailfishToolsDir Condition="'$(SailfishToolsDir)' == '' and Exists('$(MSBuildThisFileDirectory)../../../tools/sf')">$(MSBuildThisFileDirectory)../../../tools/</SailfishToolsDir>
    <SailfishToolsDir Condition="'$(SailfishToolsDir)' == ''">$(MSBuildThisFileDirectory)tools/</SailfishToolsDir>
  </PropertyGroup>

  <!-- No Publish dependency: `sf deploy` publishes itself, and a dependency would publish twice. -->
  <Target Name="SailfishRun"
          Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <Error Condition="!Exists('$(SailfishToolsDir)sf')"
           Text="Sailfish device tools not found at $(SailfishToolsDir). Set -p:SailfishToolsDir= to a checkout's tools/ directory." />
    <Exec Command="SF_SAMPLE_DIR=&quot;$(MSBuildProjectDirectory)&quot; bash &quot;$(SailfishToolsDir)sf&quot; setup --if-needed" />
    <Message Importance="high" Text="SailfishRun: deploying $(SailfishPackageName) and launching on the device (tools: $(SailfishToolsDir))..." />
    <Exec Command="SF_SAMPLE_DIR=&quot;$(MSBuildProjectDirectory)&quot; SF_PKG=&quot;$(SailfishPackageName)&quot; SF_BIN=&quot;$(AssemblyName)&quot; SF_TFM=&quot;$(TargetFramework)&quot; SF_CONFIGURATION=&quot;$(Configuration)&quot; bash &quot;$(SailfishToolsDir)sf&quot; deploy --run" />
  </Target>

  <!-- ================= dotnet run ================= -->
  <!-- Its own file, imported for this leg only: a DeployToDevice defined on every leg would replace the Android or iOS
       SDK's own when a multi-head project references the package on those legs too. -->
  <Import Project="$(MSBuildThisFileDirectory)Microsoft.Maui.Platforms.SailfishOS.Run.targets"
          Condition="'$(_SailfishLegPlatform)' == 'sailfish' And '$(_SailfishIsApp)' == 'true'" />

  <!-- ================= Build-time Warning ================= -->
  <!-- One-time phone setup: -t:SailfishSetup (-p:SailfishSetupForce=true to redo). -->
  <Target Name="SailfishSetup"
          Condition="'$(_SailfishLegPlatform)' == 'sailfish'">
    <Error Condition="!Exists('$(SailfishToolsDir)sf')"
           Text="Sailfish device tools not found at $(SailfishToolsDir). Set -p:SailfishToolsDir= to a checkout's tools/ directory." />
    <Exec Command="SF_SAMPLE_DIR=&quot;$(MSBuildProjectDirectory)&quot; bash &quot;$(SailfishToolsDir)sf&quot; setup$(_SailfishSetupForceArg)" />
  </Target>
  <PropertyGroup>
    <_SailfishSetupForceArg Condition="'$(SailfishSetupForce)' == 'true'"> --force</_SailfishSetupForceArg>
  </PropertyGroup>

  <Target Name="_WarnSailfishRpmRequiresPublish"
          Condition="'$(CreateSailfishRpm)' == 'true' and '$(_SailfishRpmDefaulted)' != 'true'"
          AfterTargets="Build"
          BeforeTargets="Publish">

    <Warning Text="CreateSailfishRpm=true has no effect with dotnet build. Use dotnet publish -f net11.0-sailfish (or -r linux-x64 -p:SelfContained=true -p:CreateSailfishRpm=true on the plain net11.0 leg) instead."
             Condition="'$(IsPublishing)' != 'true' and '$(_IsPublishing)' != 'true' and '$(DeployOnBuild)' != 'true'" />
  </Target>

</Project>