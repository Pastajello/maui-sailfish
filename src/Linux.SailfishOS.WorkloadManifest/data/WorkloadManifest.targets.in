<Project>
  <!-- Loaded before restore, the only point early enough to accept the net11.0-sailfish TFM; the package targets do the rest. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' And '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'sailfish'">
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <!-- NuGet needs a platform version (NU1012); 1.0 keeps the TFM OS-version-neutral. -->
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == ''">1.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(SupportedOSPlatformVersion)' == ''">1.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- App heads only: a class library with the TFM stays RID-neutral and framework-dependent. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' And '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'sailfish' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
    <!-- The device RID must be known at restore (NETSDK1047 otherwise), and restore never sees the package's targets;
         a multi-head app would need it in its csproj without this. 32-bit phones set linux-arm; SailfishRuntimeIdentifier
         picks it for this head only (tools/sf deploy), where a global -r would reach every head. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(SailfishRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-arm64</RuntimeIdentifier>
    <!-- Self-contained from restore on, so restore downloads the runtime pack (NETSDK1112 on a clean machine
         otherwise: the package's buildTransitive targets set it, too late for restore). -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <!-- The payload profile's packs (crossgen2 for ReadyToRun, ILLink for trimming) must be in the restore too: NuGet
         evaluates with ExcludeRestorePackageImports, so the package's SailfishReadyToRun/SailfishTrim never reach it, and
         a Release publish on a clean NuGet cache failed with NETSDK1094 (tracker S57). Restore only: during the build
         the package targets decide, per configuration. -->
    <PublishReadyToRun Condition="'$(ExcludeRestorePackageImports)' == 'true' And '$(PublishReadyToRun)' == '' And '$(SailfishReadyToRun)' != 'false'">true</PublishReadyToRun>
    <PublishTrimmed Condition="'$(ExcludeRestorePackageImports)' == 'true' And '$(PublishTrimmed)' == '' And '$(SailfishTrim)' != 'false'">true</PublishTrimmed>
  </PropertyGroup>

  <!-- The backend package comes with the TFM, like an in-box workload's packs: adding net11.0-sailfish to
       TargetFrameworks is enough. An explicit PackageReference wins; SailfishImplicitPackageReference=false opts out.
       IsImplicitlyDefined, as on the SDK's own implicit references, keeps central package management from
       rejecting its Version (NU1008). -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' And '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'sailfish'">
    <SailfishPackageVersion Condition="'$(SailfishPackageVersion)' == ''">@SAILFISH_VERSION@</SailfishPackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != '' And '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'sailfish' And '$(SailfishImplicitPackageReference)' != 'false' And '@(PackageReference->WithMetadataValue(&quot;Identity&quot;, &quot;Microsoft.Maui.Platforms.SailfishOS&quot;))' == ''">
    <PackageReference Include="Microsoft.Maui.Platforms.SailfishOS" Version="$(SailfishPackageVersion)" IsImplicitlyDefined="true" />
  </ItemGroup>

  <!-- dotnet run's device deploy, declared before restore (see the file). -->
  <Import Project="$(MSBuildThisFileDirectory)WorkloadManifest.Run.targets"
          Condition="'$(TargetFramework)' != '' And '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'sailfish' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And Exists('$(MSBuildThisFileDirectory)WorkloadManifest.Run.targets')" />

  <!-- The SDK validates the platform version against this list (NETSDK1140 without it). -->
  <ItemGroup Condition="'$(TargetFramework)' != '' And '$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'sailfish'">
    <SdkSupportedTargetPlatformVersion Include="1.0" />
  </ItemGroup>
</Project>
