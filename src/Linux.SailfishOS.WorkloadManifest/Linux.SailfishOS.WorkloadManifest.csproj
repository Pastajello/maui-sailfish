<Project Sdk="Microsoft.NET.Sdk">

  <!-- Workload manifest package: WorkloadManifest.json/targets in the SDK's
       sdk-manifests/<band>/ are what make the net11.0-sailfish TFM
       recognizable before restore (P0.4). Installed by tools/sf workload-install
       (a checkout) or the sailfish-workload tool (Linux.SailfishOS.Workload,
       which embeds the same files). SailfishWorkloadBand (Directory.Build.props)
       must match the SDK feature band (global.json). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>microsoft.maui.platforms.sailfishos.Manifest-$(SailfishWorkloadBand)</PackageId>
    <Version>$(PlatformMauiSailfishVersion)</Version>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NETSDK1210</NoWarn>
    <!-- The repo-wide Directory.Build.props points PackageReadmeFile at a
         README.md this pack does not ship. -->
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

  <!-- The manifest carries the package version as text: written from data/*.in with PlatformMauiSailfishVersion. -->
  <Import Project="SailfishVersionedFiles.targets" />
  <ItemGroup>
    <SailfishVersioned Include="data/WorkloadManifest.json.in" TargetPath="WorkloadManifest.json" />
    <SailfishVersioned Include="data/WorkloadManifest.targets.in" TargetPath="WorkloadManifest.targets" />
    <None Include="data/WorkloadManifest.Run.targets" Pack="true" PackagePath="data/WorkloadManifest.Run.targets" />
  </ItemGroup>
  <Target Name="_SailfishPackVersionedManifest" AfterTargets="SailfishCollectVersioned" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="@(SailfishVersionedOutput)" Pack="true" PackagePath="data/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
