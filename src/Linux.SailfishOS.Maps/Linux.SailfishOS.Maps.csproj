<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sailfish OS handler for Microsoft.Maui.Controls.Maps (Map, Pin, Polyline, Polygon, Circle) on QtLocation with
       OpenStreetMap tiles. The app keeps calling UseMauiMaps() as on every platform. QtLocation is not part of a
       default Sailfish OS install: the package's targets add the RPM Requires (not in a Harbour build, where the
       Store refuses them and the map shows a placeholder). See docs/trailhead-plan.md (T08). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Microsoft.Maui.SailfishOS.Maps</RootNamespace>
    <AssemblyName>Microsoft.Maui.SailfishOS.Maps</AssemblyName>
    <PackageId>Microsoft.Maui.Platforms.SailfishOS.Maps</PackageId>
    <Version>$(PlatformMauiSailfishVersion)</Version>
    <Description>Sailfish OS handler for Microsoft.Maui.Controls.Maps on QtLocation (OpenStreetMap tiles): reference it next to Microsoft.Maui.Controls.Maps in the Sailfish head and call UseMauiMaps().</Description>
    <PackageTags>maui;sailfish;sailfishos;maps;openstreetmap</PackageTags>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Linux.SailfishOS/Linux.SailfishOS.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Linux.SailfishOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/**" Pack="true"
          PackagePath="buildTransitive/net11.0/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
