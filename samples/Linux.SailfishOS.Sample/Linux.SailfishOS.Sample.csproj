<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Microsoft.Maui.SailfishOS.Sample</RootNamespace>
    <ApplicationId>com.maui.sailfish.sample</ApplicationId>
    <ApplicationTitle>MAUI Sailfish Sample</ApplicationTitle>
    <Version>$(PlatformMauiSailfishVersion)</Version>
    <IsPackable>false</IsPackable>
    <!-- XAML is compiled by source generation; no runtime inflator. -->
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- The sample only uses InvariantCulture, so drop ICU from the payload.
         TODO: DatePicker behaviour under invariant mode is untested. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- mauisample:// links open the app (Application.OnAppLinkRequestReceived); leg silica K checks the path. -->
    <SailfishUrlSchemes>mauisample</SailfishUrlSchemes>
    <!-- The acceptance host exercises services Sailjail has no permission for (F4 checks the flashlight), so it opts out
         of the default sandbox; the Harbour leg (-p:SailfishHarbour=true) keeps it. -->
    <SailfishSandboxing Condition="'$(SailfishHarbour)' != 'true'">false</SailfishSandboxing>
    <!-- The backend comes by ProjectReference, so its native assets come from tools/sf native-build's output
         (package consumers get them from the package). -->
    <SailfishNativeAssetsDir>$(MSBuildThisFileDirectory)../../artifacts/native</SailfishNativeAssetsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Linux.SailfishOS/Linux.SailfishOS.csproj" />
    <ProjectReference Include="../../src/Linux.SailfishOS.Diagnostics/Linux.SailfishOS.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harbour icon must be a 108x108 PNG (checked at pack time), so ship a pre-sized one. -->
    <MauiIcon Include="Resources\AppIcon\appicon-sailfish.png" />
  </ItemGroup>

  <!-- Images ship under images/, where the platform's image resolver looks. -->
  <ItemGroup>
    <Content Include="Resources\Images\*.png;Resources\Images\*.gif" CopyToOutputDirectory="PreserveNewest" Link="images\%(Filename)%(Extension)">
      <TargetPath>images/%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Import the Sailfish OS RPM packaging targets -->
  <Import Project="../../src/Linux.SailfishOS/buildTransitive/Microsoft.Maui.SailfishOS.targets" />

</Project>