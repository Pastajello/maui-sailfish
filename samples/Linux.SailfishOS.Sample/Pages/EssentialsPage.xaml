<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Microsoft.Maui.SailfishOS.Sample.Pages.EssentialsPage"
             Title="Essentials"
             BackgroundColor="#101018">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="10">

            <Label x:Name="DeviceLabel" FontSize="18" TextColor="White" Text="device: …" />
            <Label x:Name="DisplayLabel" FontSize="18" TextColor="White" Text="display: …" />
            <Label x:Name="AppLabel" FontSize="18" TextColor="White" Text="app: …" />
            <Label x:Name="PrefsLabel" FontSize="18" TextColor="White" Text="prefs: …" />
            <Label x:Name="ClipboardLabel" FontSize="18" TextColor="White" Text="clipboard: …" />
            <Label x:Name="FilesLabel" FontSize="18" TextColor="White" Text="files: …" />
            <Label x:Name="StateLabel" FontSize="18" TextColor="White" Text="state: …" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Write prefs" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnWritePrefsClicked" />
                <Button Grid.Column="1" Text="Read prefs" BackgroundColor="#37474F" TextColor="White" Clicked="OnReadPrefsClicked" />
                <Button Grid.Row="1" Grid.Column="0" Text="Copy to clipboard" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnCopyClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Read clipboard" BackgroundColor="#37474F" TextColor="White" Clicked="OnPasteClicked" />
                <Button Grid.Row="2" Grid.Column="0" Text="Write+read file" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnFileClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="Vibrate" BackgroundColor="#37474F" TextColor="White" Clicked="OnVibrateClicked" />
                <Button Grid.Row="3" Grid.Column="0" Text="Location" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnLocationClicked" />
                <Button Grid.Row="3" Grid.Column="1" Text="Open browser" BackgroundColor="#37474F" TextColor="White" Clicked="OnBrowserClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
