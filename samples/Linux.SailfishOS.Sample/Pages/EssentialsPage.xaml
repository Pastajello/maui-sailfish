<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Microsoft.Maui.SailfishOS.Sample.Pages.EssentialsPage"
             Title="Essentials"
             BackgroundColor="#101018">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="10">

            <Label x:Name="DeviceLabel" FontSize="18" TextColor="White" Text="device: …" />
            <Label x:Name="DisplayLabel" FontSize="18" TextColor="White" Text="display: …" />
            <Label x:Name="AppLabel" FontSize="18" TextColor="White" Text="app: …" />
            <Label x:Name="PrefsLabel" FontSize="18" TextColor="White" Text="prefs: …" />
            <Label x:Name="ClipboardLabel" FontSize="18" TextColor="White" Text="clipboard: …" />
            <Label x:Name="FilesLabel" FontSize="18" TextColor="White" Text="files: …" />
            <Label x:Name="StateLabel" FontSize="18" TextColor="White" Text="state: …" />
            <Label x:Name="SecureLabel" FontSize="18" TextColor="White" Text="secure: …" LineBreakMode="WordWrap" />
            <Label x:Name="MoreLabel" FontSize="18" TextColor="White" Text="more: …" LineBreakMode="WordWrap" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Column="0" Text="Write prefs" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnWritePrefsClicked" />
                <Button Grid.Column="1" Text="Read prefs" BackgroundColor="#37474F" TextColor="White" Clicked="OnReadPrefsClicked" />
                <Button Grid.Row="1" Grid.Column="0" Text="Copy to clipboard" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnCopyClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Read clipboard" BackgroundColor="#37474F" TextColor="White" Clicked="OnPasteClicked" />
                <Button Grid.Row="2" Grid.Column="0" Text="Write+read file" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnFileClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="Vibrate" BackgroundColor="#37474F" TextColor="White" Clicked="OnVibrateClicked" />
                <Button Grid.Row="3" Grid.Column="0" Text="Location" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnLocationClicked" />
                <Button Grid.Row="3" Grid.Column="1" Text="Open browser" BackgroundColor="#37474F" TextColor="White" Clicked="OnBrowserClicked" />
                <Button Grid.Row="4" Grid.Column="0" Text="Secure: save" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnSecureSaveClicked" />
                <Button Grid.Row="4" Grid.Column="1" Text="Secure: read" BackgroundColor="#37474F" TextColor="White" Clicked="OnSecureReadClicked" />
                <Button Grid.Row="5" Grid.Column="0" Text="Secure: remove" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnSecureRemoveClicked" />
                <Button Grid.Row="5" Grid.Column="1" Text="Speak" BackgroundColor="#37474F" TextColor="White" Clicked="OnSpeakClicked" />
                <Button Grid.Row="6" Grid.Column="0" Text="Torch on" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnTorchOnClicked" />
                <Button Grid.Row="6" Grid.Column="1" Text="Torch off" BackgroundColor="#37474F" TextColor="White" Clicked="OnTorchOffClicked" />
                <Button Grid.Row="7" Grid.Column="0" Text="Pick contact" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnPickContactClicked" />
                <Button Grid.Row="7" Grid.Column="1" Text="Count contacts" BackgroundColor="#37474F" TextColor="White" Clicked="OnCountContactsClicked" />
                <Button Grid.Row="8" Grid.Column="0" Text="Cover actions" BackgroundColor="#2E6BB0" TextColor="White" Clicked="OnCoverActionsClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
