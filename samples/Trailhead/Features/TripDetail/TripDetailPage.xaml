<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Trailhead.Features.Shared"
             xmlns:local="clr-namespace:Trailhead.Features.TripDetail"
             xmlns:charts="clr-namespace:Trailhead.Features.Charts"
             x:Class="Trailhead.Features.TripDetail.TripDetailPage"
             x:DataType="local:TripDetailViewModel"
             Title="{Binding Name}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:T Delete}" Clicked="OnDelete" />
        <ToolbarItem Text="{l:T Share GPX}" Clicked="OnShare" />
        <ToolbarItem Text="{l:T Import photos}" Clicked="OnImportPhotos" />
        <ToolbarItem Text="{l:T Edit}" Clicked="OnEdit" />
        <ToolbarItem Text="{l:T Map}" Clicked="OnMap" />
    </ContentPage.ToolbarItems>

    <!-- The whole page is one list: the trip's facts are its header, the photos a three-column grid. -->
    <CollectionView x:Name="Grid"
                    ItemsSource="{Binding Photos}"
                    SelectionMode="Single"
                    SelectionChanged="OnPhotoSelected">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Spacing="12" Padding="0,0,0,12">
                <Image Source="{Binding Hero}" Aspect="AspectFill" HeightRequest="230" IsVisible="{Binding HasHero}" />
                <VerticalStackLayout Padding="16,0" Spacing="4">
                    <Label Text="{Binding Subtitle}" FontSize="14" TextColor="{DynamicResource Highlight}" />
                    <!-- Six statistics: value in the highlight colour, label below, three per row. -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Stats}" Wrap="Wrap" Margin="0,8,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:StatCell">
                                <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="0,6">
                                    <Label Text="{Binding Value}" FontSize="20" TextColor="{DynamicResource Highlight}" />
                                    <Label Text="{Binding Label}" FontSize="13" TextColor="{DynamicResource Secondary}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <!-- SkiaSharp: drag a finger along the profile to read distance and height. -->
                    <charts:ElevationChart x:Name="Profile" Track="{Binding Track}" Margin="0,8,0,0"
                                           Color="{DynamicResource Highlight}" TextColor="{DynamicResource Primary}"
                                           Scrubbed="OnProfileScrubbed"
                                           SemanticProperties.Description="{l:T 'Elevation profile'}"
                                           SemanticProperties.Hint="{l:T 'Drag a finger along it to read the height'}" />
                    <Label Text="{Binding ScrubText}" FontSize="13" TextColor="{DynamicResource Secondary}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Notes}" Margin="0,8,0,0" />
                    <Label Text="{Binding PhotosHeader}" FontSize="15" TextColor="{DynamicResource Highlight}"
                           HorizontalTextAlignment="End" Margin="0,16,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:PhotoItem">
                <Image Source="{Binding Thumbnail}" Aspect="AspectFill" HeightRequest="120" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
