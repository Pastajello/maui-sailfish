<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Sailfish OS through the Microsoft.Maui.Platforms.SailfishOS package; on a Mac also iOS, to compare native UIKit rendering. -->
		<TargetFrameworks>net11.0-sailfish</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net11.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>SailfishKitchen</RootNamespace>
		<!-- The in-box heads build through the MAUI workload; the Sailfish head needs none. -->
		<UseMaui Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'sailfish'">true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Sailfish Kitchen</ApplicationTitle>

		<!-- App Identifier (Sailfish: the RPM is harbour-<last segment>) -->
		<ApplicationId>com.maui.sailfishkitchen</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<!-- XAML compiled by the source generator (no runtime inflator). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<!-- No ICU in the payload: every format/parse goes through InvariantCulture. -->
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- CommunityToolkit.Mvvm: generated partial members we do not own. -->
		<NoWarn>$(NoWarn);MVVMTK0034</NoWarn>
	</PropertyGroup>

	<!-- `dotnet publish -f net11.0-sailfish` builds the harbour RPM; `-t:SailfishRun` deploys and runs it. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'sailfish'">
		<RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Offline seed catalog, read from <app>/seed/ (KITCHEN_OFFLINE=1) -->
		<MauiAsset Include="Resources\Seed\*.json" LogicalName="seed/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.4" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.4" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'sailfish'">
		<PackageReference Include="Microsoft.Maui.Platforms.SailfishOS" Version="$(PlatformMauiSailfishVersion)" />
	</ItemGroup>

</Project>
