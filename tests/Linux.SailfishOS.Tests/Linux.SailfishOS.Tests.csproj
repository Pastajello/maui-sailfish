<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Runs on the build host (no device): pure managed contracts only —
         bridge serialization and the QML adapter library contract. Device
         behaviour stays covered by tools/sf matrix. -->
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot">
      <Value>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</Value>
    </AssemblyMetadata>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Linux.SailfishOS/Linux.SailfishOS.csproj" />
    <ProjectReference Include="../../src/Linux.SailfishOS.Diagnostics/Linux.SailfishOS.Diagnostics.csproj" />
    <ProjectReference Include="../../src/Linux.SailfishOS.SkiaSharp/Linux.SailfishOS.SkiaSharp.csproj" />
    <ProjectReference Include="../../src/Linux.SailfishOS.Workload/Linux.SailfishOS.Workload.csproj" />
    <ProjectReference Include="../../src/Linux.SailfishOS.Tools/Linux.SailfishOS.Tools.csproj" />
    <ProjectReference Include="../../src/Linux.SailfishOS.Build.Tasks/Linux.SailfishOS.Build.Tasks.csproj" />
    <!-- The build tasks run in MSBuild; their tests host them with the same assemblies. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
  </ItemGroup>

</Project>
