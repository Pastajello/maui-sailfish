<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compile-only guard (architecture alignment stage A0): what an app or a control library writes
       against Microsoft.Maui.SailfishOS, using public API only. The assembly name is not in the backend's
       InternalsVisibleTo list, and warnings fail the build. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Linux.SailfishOS/Linux.SailfishOS.csproj" />
  </ItemGroup>

</Project>
